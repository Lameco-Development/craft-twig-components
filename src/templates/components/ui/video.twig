{# Theme #}
{% set theme = theme is defined and theme is not empty
  ? theme|json_decode
  : _globals.get('lameco.components.theme')
%}

{# Component Variables #}
{% set video = video ?? null %}
{% set image = image ?? null %}
{% set imageTransform = imageTransform ?? null %}
{% set class = class ?? 'aspect-video relative' %}
{% set consentType = consentType ?? 'marketing' %}
{% set mode = theme.ui.video.mode ?? 'embed' %}
{% set videoOptions = videoOptions ?? (mode == 'lightbox' ? ['autoplay=1', 'byline=0', 'title=0'] : []) %}

{# Component #}
{% if video is not empty %}
  {# Get embeddedAsset from video [asset] #}
  {% set embeddedAsset = craft.embeddedAssets.get(video) %}
  {% if embeddedAsset is not empty %}
    {# Get image from embeddedAsset if image is not defined #}
    {% set image = image is empty ? embeddedAsset.image : image %}

    {# An embed loaded with dnt=1 (Vimeo's Do Not Track) sets no tracking or
       advertising cookies and does no profiling, so it needs no consent. Load it
       directly; only gate embeds that can actually track. Embedded Assets adds
       dnt=1 to Vimeo iframes when its "force dnt" setting is on. #}
    {% set iframeSrc = embeddedAsset.getIframeSrc(videoOptions) %}
    {% set needsConsent = 'dnt=1' not in iframeSrc %}

    {# Check Theme Configuration Mode #}

    {# Mode = 'embed' #}
    {% if mode == 'embed' %}
      <div class="{{ class }} {{ theme.ui.video.embed.class ?? '' }}">
        {{ _self.image(image, imageTransform, video) }}

        <iframe
          class="absolute inset-0 h-full w-full"
          {% if needsConsent %}
            data-cookieblock-src="{{ iframeSrc }}"
            data-cookieconsent="{{ consentType }}"
          {% else %}
            src="{{ iframeSrc }}"
            loading="lazy"
          {% endif %}
          allowfullscreen
        ></iframe>

        {{ _self.consent(needsConsent, consentType, theme) }}
      </div>

    {# Mode = 'lightbox #}
    {% elseif mode == 'lightbox' %}
      <div class="relative ui-video__iframe--js {{ class }}  {{ theme.ui.video.lightbox.class ?? '' }}">
        {{ _self.image(image, imageTransform, video) }}

        <a href="{{ iframeSrc }}" data-pswp-type="iframe" data-pswp-iframe-url="{{ iframeSrc }}" aria-label="{{ 'aria.video.play' | t}}" class="{% if needsConsent %}cookieconsent-optin-{{ consentType }}{% endif %} absolute top-1/2 start-1/2 -translate-1/2 {{ theme.ui.video.lightbox.button.class ?? '' }}">
          {{ theme.ui.video.lightbox is defined and theme.ui.video.lightbox.button.html ? (theme.ui.video.lightbox.button.html | raw) : '<i class="fa-solid fa-play"></i>' }}
        </a>

        {# Concent overlay #}
        {{ _self.consent(needsConsent, consentType, theme) }}
      </div>
    {% endif %}

  {% elseif video.kind is defined and video.kind == 'video' %}
    {# Mode = 'embed' #}
    {% if mode == 'embed' %}
      <div class="{{ class }} {{ theme.ui.video.embed.class ?? '' }}">
        {{ _self.image(image, imageTransform, video) }}

        <video
          class="absolute inset-0 h-full w-full"
          controls
          playsinline
        >
          <source src="{{ video.url }}" type="{{ video.mimeType }}">
        </video>
      </div>

    {# Mode = 'lightbox' #}
    {% elseif mode == 'lightbox' %}
      <div class="relative ui-video__iframe--js {{ class }} {{ theme.ui.video.lightbox.class ?? '' }}">
        {{ _self.image(image, imageTransform, video) }}

        <a
          href="{{ video.url }}"
          data-pswp-type="video"
          data-pswp-video-url="{{ video.url }}"
          data-pswp-video-type="{{ video.mimeType }}"
          aria-label="{{ 'aria.video.play' | t }}"
          class="absolute top-1/2 start-1/2 -translate-1/2 {{ theme.ui.video.lightbox.button.class ?? '' }}"
        >
          {{ theme.ui.video.lightbox is defined and theme.ui.video.lightbox.button.html ? (theme.ui.video.lightbox.button.html | raw) : '<i class="fa-solid fa-play"></i>' }}
        </a>
      </div>
    {% endif %}
  {% endif %}
{% endif %}

{% macro image (image, imageTransform, video) %}
  {% if image is string %}
    <img
      src="{{ image }}"
      alt="{{ video.title }}"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover"
    />
  {% else %}
    <x-ui.image image="{{ image }}" transform="{{ imageTransform }}" class="absolute inset-0 h-full w-full object-cover"></x-ui.image>
  {% endif %}
{% endmacro %}

{% macro consent (needsConsent, consentType, theme) %}
  {% if needsConsent %}
    {% set class = "absolute inset-0 h-full w-full flex justify-center items-center " ~ theme.ui.video.consent.class ?? '' %}
    <x-consent.default class="{{ class }}" consentType="{{ consentType }}" type="video"></x-consent.default>
  {% endif %}
{% endmacro %}
